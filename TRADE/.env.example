# === REQUIRED CONFIGURATION ===
PROXY_WALLET=0x0987654321098765432109876543210987654321  # Your Polymarket wallet
PK=0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890  # Your private key

# API Configuration
HOST=https://clob.polymarket.com
POLYMARKET_API_URL=https://gamma-api.polymarket.com

# === SCALPING BOT CONFIGURATION ===

# Trading Parameters
SCAN_INTERVAL=0.1  # Check markets every 0.1 seconds (ultra-fast)
MAX_POSITION_SIZE=50.0  # Maximum USDC per position
MAX_TOTAL_EXPOSURE=500.0  # Maximum total USDC across all positions
MIN_TRADE_SIZE=1.0  # Minimum trade size in USDC

# Strategy: Binary Arbitrage
ENABLE_ARBITRAGE=true
ARB_MIN_PROFIT=0.01  # Minimum 1¢ profit to execute arbitrage
ARB_POSITION_SIZE=10  # Standard position size for arbitrage (shares)

# Strategy: Momentum Scalping
ENABLE_MOMENTUM=true
MOMENTUM_PROFIT_TARGET=0.02  # Take profit at 2¢ per share
MOMENTUM_STOP_LOSS=0.05  # Stop loss at 5¢ per share
MOMENTUM_PRICE_CHANGE_THRESHOLD=0.03  # Enter on 3% price change
MOMENTUM_POSITION_SIZES=10,37,62,75  # Standard position sizes

# Strategy: Mean Reversion
ENABLE_MEAN_REVERSION=true
MEAN_REV_ENTRY_HIGH=0.70  # Enter contrarian when price > 70%
MEAN_REV_ENTRY_LOW=0.30  # Enter contrarian when price < 30%
MEAN_REV_EXIT_TARGET=0.50  # Exit when price approaches 50%
MEAN_REV_PROFIT_TARGET=0.05  # Minimum 5¢ profit target

# Strategy: Market Making
ENABLE_MARKET_MAKING=false  # Advanced strategy - disable by default
MM_SPREAD_TARGET=0.02  # Target 2¢ spread
MM_ORDER_SIZE=10  # Size for maker orders

# Market Selection
PREFERRED_MARKETS=bitcoin,ethereum  # Focus on BTC and ETH
HOURLY_MARKETS_ONLY=true  # Only trade hourly markets (lower risk)
MAX_DAYS_TO_EXPIRY=1  # Only markets expiring within 1 day

# Risk Management
MAX_LOSS_PER_TRADE=5.00  # Max $5 loss per trade
MAX_DAILY_LOSS=50.00  # Stop trading after $50 daily loss
MAX_CONCURRENT_POSITIONS=10  # Maximum number of open positions
POSITION_HOLD_TIME=300  # Max 300 seconds (5 min) hold time

# Web3 config
RPC_URL=https://polygon-rpc.com
USDC_CONTRACT_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
